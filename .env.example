DATABASE_URL=postgresql+psycopg://voicelens:voicelens@postgres:5432/voicelens
REDIS_URL=redis://redis:6379/0
# Production-safe default. Set to false only for local unauthenticated demos.
AUTH_REQUIRED=true
OUTBOX_RELAY_INTERVAL_SECONDS=5
VOICELENS_ENV=development
AUTH_INSECURE_DEV=true
# 会话存储:db 表示写入 PostgreSQL(生产必须)
SESSION_STORE=db
# 本地 http 场景的显式不安全开关;生产启动检测到即失败
# (上面已有一行为 true,生产请改为 false 并置 AUTH_REQUIRED=true)
# 身份提供商:local(默认,账号见 LOCAL_ACCOUNTS)或 oidc
IDENTITY_PROVIDER=local
# OIDC 模式必填:OIDC_ISSUER / OIDC_AUDIENCE / OIDC_JWKS_URL

# 看门狗检查间隔(秒),见 compose.yaml 的 watchdog 服务
WATCHDOG_INTERVAL_SECONDS=30
# 备份保留天数(§10.4 初始7天;实际保留周期须与企业约定一致,不是已认可的策略)
BACKUP_RETENTION_DAYS=7
# 备份产物目录(scripts/backup.py 默认值);目录内含 .gitignore,禁止把备份打进交付包
BACKUP_DIR=backups

# —— 命名模式(14.1)——
# mock:确定性演示命名,仅用于开发;production 启动检测到即失败
# provider:调用外部模型,需配 MODEL_ENDPOINT / MODEL_ID / 价格
# manual:不调用模型,保留真实向量与聚类,等待人工命名
NAMING_MODE=mock
# 14.1 的模型配置键。MODEL_API_KEY 只注入 worker,不出现在前端或 API 响应里;
# MODEL_REVISION 是本地向量模型的锁定版本,不使用随时间漂移的空值。
MODEL_PROVIDER=http
# MODEL_ENDPOINT=https://model.example/v1/name
# MODEL_ID=
# MODEL_API_KEY=
# MODEL_REVISION=
# MODEL_TIMEOUT_SECONDS=30
# 10.5:没有可靠价格配置时禁用付费模式,而不是默认为免费。
# 两者缺一,provider 模式不会发出任何请求。
# MODEL_PRICE_IN=
# MODEL_PRICE_OUT=
# DAILY_MODEL_BUDGET=

# —— 向量(8.2 的接入点)——
# api:调用外部向量服务,需配 EMBEDDING_ENDPOINT / EMBEDDING_MODEL;
# hashing:本地哈希替身,仅开发与演示,production 启动检测到即失败。
#
# 注意:计划 8.2 冻结的是**本地 CPU** 模型 BAAI/bge-small-zh-v1.5。改用远端 API
# 意味着脱敏正文要外发给第三方,§10.2 要求「真实数据外发前先确认条件」——
# 这不是一个纯技术替换,部署前请先确认这一条。
# 要换回本地模型时,按 app/embedding_provider.py 的 EmbeddingProvider 协议加一个
# 实现即可,流水线与聚类都不用动。
EMBEDDING_MODE=hashing
# EMBEDDING_ENDPOINT=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_REVISION=
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_BATCH_SIZE=32

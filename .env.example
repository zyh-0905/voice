# 本文件是键目录与非 compose 本地直跑的开发默认值,同时被 compose 用作 env_file。
# 注意:compose 里闸门相关的开关(VOICELENS_ENV/NAMING_MODE/EMBEDDING_MODE/
# 模型端点/密钥等)由 compose.yaml 的 environment 插值控制,根目录 .env(可由
# .env.production.example 复制而来)优先级最高——只改本文件的这些键对 compose
# 栈无效。生产部署看 .env.production.example。
DATABASE_URL=postgresql+psycopg://voicelens:voicelens@postgres:5432/voicelens
REDIS_URL=redis://redis:6379/0
# Production-safe default. Set to false only for local unauthenticated demos.
AUTH_REQUIRED=true
OUTBOX_RELAY_INTERVAL_SECONDS=5
VOICELENS_ENV=development
AUTH_INSECURE_DEV=true
# 脱敏去重 HMAC 的密钥(4.4 event_key)。留空回落内置演示密钥(仅开发);
# 生产必须配独立随机值——settings.py 的启动校验会拦(此前这个生产必填键
# 不在样例里,生产部署只能靠读代码才发现它)。
DEDUPE_HMAC_SECRET=
# 会话存储:db 表示写入 PostgreSQL(生产必须)
SESSION_STORE=db
# 本地 http 场景的显式不安全开关;生产启动检测到即失败
# (上面已有一行为 true,生产请改为 false 并置 AUTH_REQUIRED=true)
# 身份提供商:local(默认,账号见 LOCAL_ACCOUNTS)或 oidc
IDENTITY_PROVIDER=local
# OIDC 模式必填:OIDC_ISSUER / OIDC_AUDIENCE / OIDC_JWKS_URL
# 本地账号(IDENTITY_PROVIDER=local 时使用)。形状是「用户名 → 账号记录」的 JSON,
# 哈希由 `python -m app.admin` 生成。
# **留空会回落到内置演示账号 demo/demo、viewer/viewer**——所以生产启动要求这一项
# 非空(见 app/settings.py 的生产校验);开发环境留空即可。
# 例:LOCAL_ACCOUNTS={"analyst":{"id":"u1","role":"ANALYST","password_hash":"$argon2id$..."}}
LOCAL_ACCOUNTS=

# 看门狗检查间隔(秒),见 compose.yaml 的 watchdog 服务
WATCHDOG_INTERVAL_SECONDS=30
# 备份保留天数(§10.4 初始7天;实际保留周期须与企业约定一致,不是已认可的策略)
BACKUP_RETENTION_DAYS=7
# 备份产物目录(scripts/backup.py 默认值);目录内含 .gitignore,禁止把备份打进交付包
BACKUP_DIR=backups

# —— 命名模式(14.1)——
# mock:确定性演示命名,仅用于开发;production 启动检测到即失败
# provider:调用外部模型,需配 MODEL_ENDPOINT / MODEL_ID / 价格
# manual:不调用模型,保留真实向量与聚类,等待人工命名
NAMING_MODE=mock
# 14.1 的模型配置键。MODEL_API_KEY 只注入 worker,不出现在前端或 API 响应里。
# (MODEL_REVISION 属于尚未实现的本地向量模型工作流,见 8.2;API 路径用
# EMBEDDING_REVISION。零读者的键不收录——收录了也没有任何代码会读它,
# 配了只会造成「改了有效」的错觉。)
MODEL_PROVIDER=http
# 多数 LLM 网关在同一 host 上同时提供 /chat/completions 与 /embeddings。
# 只配 MODEL_BASE_URL + MODEL_API_KEY,chat 与向量就都能用;要分别指定时,
# MODEL_ENDPOINT / EMBEDDING_ENDPOINT / EMBEDDING_API_KEY 会覆盖推导结果。
# MODEL_BASE_URL=https://gateway.example/v1
# MODEL_ENDPOINT=https://model.example/v1/chat/completions
# MODEL_ID=
# MODEL_API_KEY=
# MODEL_TIMEOUT_SECONDS=30
# 10.5:没有可靠价格配置时禁用付费模式,而不是默认为免费。
# 两者缺一,provider 模式不会发出任何请求。
# MODEL_PRICE_IN=
# MODEL_PRICE_OUT=
# DAILY_MODEL_BUDGET=

# —— 向量(8.2 的接入点)——
# api:调用外部向量服务,需配 EMBEDDING_ENDPOINT / EMBEDDING_MODEL;
# hashing:本地哈希替身,仅开发与演示,production 启动检测到即失败。
#
# 注意:计划 8.2 冻结的是**本地 CPU** 模型 BAAI/bge-small-zh-v1.5。改用远端 API
# 意味着脱敏正文要外发给第三方,§10.2 要求「真实数据外发前先确认条件」——
# 这不是一个纯技术替换,部署前请先确认这一条。
# 要换回本地模型时,按 app/embedding_provider.py 的 EmbeddingProvider 协议加一个
# 实现即可,流水线与聚类都不用动。
EMBEDDING_MODE=hashing
# EMBEDDING_ENDPOINT=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_REVISION=
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_BATCH_SIZE=32


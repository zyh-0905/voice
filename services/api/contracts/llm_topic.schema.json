{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TopicCandidate",
  "description": "主题命名阶段的 LLM 结构化输出契约(工程计划 8.5)。顶层与 claim 对象禁止额外字段;quote 仅 evidence_id 与 quote 两个字段。",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic_name", "summary", "severity", "department", "evidence_ids", "claims", "suggested_action", "needs_review", "limitations"],
  "properties": {
    "topic_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "department": { "type": "string", "maxLength": 80 },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "claims": { "type": "array", "items": { "$ref": "#/definitions/claim" } },
    "suggested_action": { "type": "string", "maxLength": 500 },
    "needs_review": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 20 }
  },
  "definitions": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "quote", "claim"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 200 },
        "claim": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}

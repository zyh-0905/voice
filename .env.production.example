# 生产部署环境样例。用法:cp .env.production.example .env(根目录,已被 gitignore),
# 填齐所有空值,docker compose up -d。compose 用本文件插值 compose.yaml 的
# environment;API 启动时逐项校验(app/settings.py),缺一项直接失败——这是刻意的:
# 「看起来能跑」的生产配置比「明确拒绝启动」的危险得多。
#
# 只收录有代码读者的键;与 .env.example 的差异就是生产闸门要求的最小集。

VOICELENS_ENV=production
AUTH_REQUIRED=true
AUTH_INSECURE_DEV=false
# 会话存储:生产必须 db(重启后会话存活)
SESSION_STORE=db
# 脱敏去重 HMAC 密钥:留空会回落内置演示密钥,启动校验会拦。用独立随机值,
DEDUPE_HMAC_SECRET=

# 与数据库口令、备份密钥都不同(10.4)。
# 身份:local(账号来自 LOCAL_ACCOUNTS,哈希用 python -m services.api.app.admin 生成)
# 或 oidc(需 OIDC_ISSUER/OIDC_AUDIENCE/OIDC_JWKS_URL)。留空账号 = 启用内置
# demo/demo、viewer/viewer——生产校验会拦。
IDENTITY_PROVIDER=local
LOCAL_ACCOUNTS=

# 命名:provider(外部模型)或 manual(不调模型,等待人工命名);mock 禁止。
NAMING_MODE=provider
# 多数网关同 host 提供 chat 与 embeddings:配 MODEL_BASE_URL + MODEL_API_KEY 即可,
# 端点按 /chat/completions 与 /embeddings 推导;MODEL_ENDPOINT/EMBEDDING_ENDPOINT
# 可显式覆盖。10.5:没有可靠价格配置时付费模式被禁用——价格是必填,不是可选。
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
MODEL_PRICE_IN=
MODEL_PRICE_OUT=
DAILY_MODEL_BUDGET=

# 向量:生产只允许 api(外部向量服务;哈希替身是演示专用)。
# 注意:计划 8.2 冻结的是本地 CPU 模型 BAAI/bge-small-zh-v1.5,远端 API 意味着
# 脱敏正文外发——上线前先确认 10.2 的外发条件(见 .env.example 同段说明)。
EMBEDDING_MODE=api
EMBEDDING_MODEL=
EMBEDDING_REVISION=

# web 镜像构建期变量:生产必须 false(真实 API 模式)。
VOICELENS_WEB_USE_MOCK=false
# 14.5 镜像级回滚用的固定 tag;发布流程(release_manifest)会写入。
VOICELENS_IMAGE_TAG=latest
